# Copia este archivo como .env en la raíz del repo (.gitignore lo deja fuera), o fuera del repo en
# un .env fuera del repo, o apunta RETINA_ENV a donde lo guardes. Nunca lo subas.
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
# Tope del proyecto en USD (autorizado: 50; pasar de 100 requiere cambiarlo a propósito)
RETINA_TOPE_USD=50
# Ruta a ffmpeg si no está en el PATH
FFMPEG=
# 0 = cualquier video va a la API de Meta (por omisión: Retina revisa antes de publicar).
# 1 = solo videos ya publicados (para una empresa que no quiera mandar borradores).
RETINA_SOLO_PUBLICADOS=0
# 1 = solo corren modelos de Meta (por omisión). 0 = prende la fórmula ajustada, para quien tenga su propio modelo.
RETINA_SOLO_MODELOS_META=1
# Muse Spark Open en Baseten (pesos abiertos). La llave sale del correo de Baseten.
BASETEN_API_KEY=
# Quién escribe la tarjeta: abierto+api (por omisión: Spark Open con rescate de Spark 1.3) · api (solo Muse Spark 1.3) · abierto (solo Spark Open)
RETINA_MOTOR=
# Opcionales: modelo de Spark Open en Baseten, modelo local de V-JEPA 2 y dónde se anotan los costos
RETINA_SPARK_OPEN=
RETINA_VJEPA=
# Dónde se anota lo que gastas (por omisión mis-revisiones/costos.jsonl, fuera del repo)
RETINA_COSTOS=
