# Copia este archivo FUERA del repo (por omisión un .env fuera del repo)
# o apunta RETINA_ENV a donde lo guardes. Nunca lo subas.
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
# Tope del proyecto en USD (autorizado: 50; pasar de 100 requiere cambiarlo a propósito)
RETINA_TOPE_USD=50
# Ruta a ffmpeg si no está en el PATH
FFMPEG=
# 1 = solo videos ya publicados van a la API de Meta (por omisión). 0 = también borradores (tu propio video).
RETINA_SOLO_PUBLICADOS=1
# Muse Spark Open en Baseten (pesos abiertos). La llave sale del correo de Baseten.
BASETEN_API_KEY=
